{
  "name": "kedge",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@kedge/web",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration --concurrency=1",
    "test:e2e": "pnpm --filter @kedge/web test:e2e",
    "db:generate": "pnpm --filter @kedge/db db:generate",
    "db:migrate": "pnpm --filter @kedge/db db:migrate",
    "db:seed": "pnpm --filter @kedge/db db:seed"
  },
  "devDependencies": {
    "turbo": "2.11.10",
    "typescript": "6.0.3"
  }
}
