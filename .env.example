# Copy to apps/web/.env.local for local development. Never commit real values.

# Public URL of the web app (used in invitation links)
APP_URL=http://localhost:3000

# Supabase project (local: `supabase start` prints these)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection used by the API layer (Drizzle). The server
# switches to the `authenticated` role per transaction so RLS applies.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres

# Integration tests run against a real local Postgres
TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/kedge_test

# Email (invitations). Optional locally: without it, emails are logged by ID only.
RESEND_API_KEY=
EMAIL_FROM="Kedge <no-reply@example.com>"

# Error tracking (optional locally)
SENTRY_DSN=

# AI (Phase 2+). Model is configured here, never hard-coded.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# 32 random bytes, base64 (openssl rand -base64 32). Encrypts bank account numbers.
BANK_ACCOUNT_ENCRYPTION_KEY=

# Local/CI only: write app emails to this directory instead of sending them
EMAIL_OUTBOX_DIR=.dev-outbox
